PORT=3000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# Database Configuration (Local or Cloud)
# For Render / Cloud Providers (Aiven, TiDB, Railway, PlanetScale):
# Either provide a full connection URI:
# DATABASE_URL=mysql://user:password@host:port/database
# Or individual fields:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dosetrack
# Set DB_SSL=true if your cloud MySQL host requires TLS/SSL (e.g. TiDB, Aiven)
DB_SSL=false

# Clinical Administrator Credentials (Auto-created on first startup)
ADMIN_EMAIL=admin@dosetrack.com
ADMIN_PASSWORD=password123
